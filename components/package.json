{
  "name": "sure-components-example",
  "version": "0.1.0",
  "private": true,
  "description": "Walk-through: a database table becomes a working, themed, validated form \u2014 with no hand-written HTML",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && node scripts/build.mjs",
