    "start": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "@shing.wong/sure-factor": "^0.3.1",
    "@shing.wong/sure-ui": "^0.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.56.0"
  }
}
